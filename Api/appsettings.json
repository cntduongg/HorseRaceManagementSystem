{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=HorseRaceDB;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "HorseRace@SuperSecretKey!Min32Chars#2025",
    "Issuer": "HorseRaceAPI",
    "Audience": "HorseRaceClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "RaceAutoStart": {
    "IntervalSeconds": 15
  },
  "TournamentStatusSync": {
    "IntervalMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "PasswordReset": {
    "ExpiryMinutes": 15,
    "MaxFailedAttempts": 5,
    "ReturnOtpInResponse": false,
    "OtpPepper": ""
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Horse Race Management System"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "https://horse-race-fe-amber.vercel.app",
      "https://horse-race-fe-*.vercel.app"
    ]
  },
  "SeedTestData": false,
  "AllowedHosts": "*"
}
